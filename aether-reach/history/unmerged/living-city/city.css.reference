/* Readable civic UI; no full-screen overlay during ordinary travel. */
#city-dialog{width:min(730px,94vw);background:linear-gradient(140deg,#244951,#182f40)}
.city-dialog-head{display:flex;gap:22px;align-items:center;margin-bottom:18px}
#city-portrait{width:78px;height:92px;flex:0 0 auto;border:1px solid #ccb37c;display:grid;place-items:center;font:32px Georgia;background:linear-gradient(145deg,var(--portrait,#ba654b),#1d394c);color:#f5e6be;border-radius:38px 38px 8px 8px}
#city-speaker{margin:6px 0;font:36px Georgia}#city-role{font:11px system-ui;letter-spacing:1.1px;color:#adcabd}
#city-speech{font:19px/1.65 Georgia;color:#f0e5cb;margin:15px 0 24px}
#city-choices{display:grid;gap:9px}#city-choices button{text-align:left;background:#315662;color:#f3e7bf;padding:14px 17px;border:1px solid #638481}
#city-wallet{font:11px system-ui;color:#c3daca;margin:19px 0}
#city-journal{width:min(1050px,96vw)}#city-character{font:15px/1.7 system-ui;color:#b8e1cb}
#city-attributes{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:18px 0 22px}
#city-attributes article,.city-mission{padding:17px;border:1px solid #517480;background:#254650;border-radius:5px}
#city-attributes h3,.city-mission h3{font:24px Georgia;margin:8px 0 12px;color:#f1dba7}
#city-attributes p,.city-mission p{font:12px/1.65 system-ui;color:#c3d9d0}
#city-attributes button,.city-mission button{font:11px system-ui;min-height:35px;margin-top:13px}
#city-missions{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}.city-mission small{font:10px/1.6 system-ui;color:#b7d6cc;display:block}
.city-mission small.active{color:#e7ce88}.city-mission small.complete{color:#8adeb4}
#city-relations{font:16px/1.7 Georgia;color:#cddfd3;border-top:1px solid #4d767c;padding-top:18px}
#city-progress{position:absolute;right:24px;top:182px;width:240px;padding:11px 14px;background:#193d49d9;border-left:2px solid #d1b479;border-radius:4px;pointer-events:none}
#city-progress b{display:block;font:9px/1.5 system-ui;letter-spacing:.8px;color:#f2d19c}
#city-progress span{display:block;font:12px/1.6 Georgia;color:#d9e5d3;margin:6px 0}
#city-progress small{font:9px system-ui;color:#a1c8c4}
#skiff-status{position:absolute;bottom:110px;left:50%;transform:translateX(-50%);font:12px/1.5 system-ui;padding:11px 18px;background:#183e4ce8;border:1px solid #ccb477;max-width:90%;color:#f4dfb1}
#combat-tools{flex-wrap:wrap;max-width:calc(100% - 360px)}
body:has(#scope-view:not([hidden])) #city-progress{visibility:hidden}
@media(max-width:680px){#city-progress{top:177px;right:12px;width:205px;padding:5px 8px}#city-progress span{font-size:10px;line-height:1.4;margin:4px 0}#city-progress b,#city-progress small{font-size:7px}#combat-tools{max-width:96%;top:132px}#city-attributes,#city-missions{grid-template-columns:1fr}#city-dialog{padding:20px}#city-speaker{font-size:28px}#city-speech{font-size:17px}#skiff-status{bottom:306px;font-size:9px;padding:8px}#city-journal-button,#mend-button{font-size:8px}.city-dialog-head{gap:13px}#city-portrait{width:57px;height:68px;font-size:25px}}
