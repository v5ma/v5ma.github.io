/* All water UI participates in the existing controller focus and dialog lifecycle. */
import {TIDE_TASKS,tideProgress} from './tideglass-world.mjs';
export function installTideglassUI(api){
 const status=document.createElement('div');status.id='tideglass-status';status.hidden=true;status.setAttribute('role','status');document.getElementById('hud').append(status);
 const style=document.createElement('style');style.textContent='#tideglass-status{position:fixed;top:66px;left:50%;transform:translateX(-50%);padding:9px 17px;background:#103e49e8;color:#e2ffef;border:1px solid #85cfc4;border-radius:4px;font:13px/1.5 system-ui;text-align:center;max-width:65vw;pointer-events:none;}@media(max-width:680px){#tideglass-status{top:56px;font-size:11px;max-width:88vw;width:fit-content}}';document.head.append(style);
 const option=document.createElement('label'),check=document.createElement('input');check.type='checkbox';check.id='water-effects';let enabled=true;try{enabled=localStorage.getItem('aether-reach.water-effects.v1')!=='off';}catch{}check.checked=enabled;api.art.setEffects(enabled);check.onchange=()=>{api.art.setEffects(check.checked);try{localStorage.setItem('aether-reach.water-effects.v1',check.checked?'on':'off');}catch{}};option.append(check,document.createTextNode(' Animated pool ripples and caustic light'));document.querySelector('.settings-grid').append(option);
 const button=document.createElement('button');button.id='pause-tideglass';button.textContent='Tideglass Reservoir / water missions';button.onclick=()=>{api.state().expedition.tracked=TIDE_TASKS[0].id;api.persist();api.journal.open(true);};document.getElementById('pause-dialog').append(button);
 return{update(){const s=api.state(),w=s.p.water;status.hidden=!api.playing()||api.paused()||!w.swimming;if(status.hidden)return;const label=api.label||((n)=>n==='jump'?'A':'B');status.textContent=(w.submerged?'SUBMERGED':'SURFACE SWIM')+' / '+label('jump')+' rise / '+label('back')+' dive toggle / Left stick swim / Suit air available';},dispose(){status.remove();style.remove();option.remove();button.remove();}};
}
