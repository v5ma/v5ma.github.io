{
    "schema":  "v5ma.comparison.full-genealogy-saturation-gate.v1",
    "adopted_at":  "2026-07-28",
    "owner":  "DSR - Comparison Wiki Expansion",
    "status":  "active-gate",
    "trigger_dispositions":  [
                                 "target-earlier",
                                 "mixed-split",
                                 "certified-insufficient",
                                 "content-insufficient",
                                 "no-match",
                                 "no-priority",
                                 "downgrade"
                             ],
    "matrix_unit":  "micah_stage_x_target_stage_x_target_atom",
    "minimum_micah_years_when_applicable":  [
                                                2011,
                                                2012,
                                                2017,
                                                2021,
                                                2022,
                                                2024,
                                                2025,
                                                2026
                                            ],
    "allowed_cell_states":  [
                                "match",
                                "partial",
                                "different",
                                "opposite",
                                "not-found-after-bounded-search",
                                "source-gated"
                            ],
    "required_fields":  [
                            "program_id",
                            "target_stage_registry",
                            "target_atom_registry",
                            "micah_stage_registry",
                            "source_family_coverage_manifest",
                            "era_vocabulary_dictionary",
                            "passage_level_source_ledger",
                            "stage_by_stage_atom_matrix",
                            "date_class_ledger",
                            "lossless_favorable_document_instance_ledger",
                            "target_document_author_edges",
                            "dated_micah_delta_ledger",
                            "union_coverage",
                            "four_lens_results",
                            "named_prior_allocation",
                            "before_state_operation_ledger",
                            "blumberg_delta_absent_from_before_state",
                            "later_target_document_delta_tests",
                            "no_rival_award_or_author_floor_attestation",
                            "apparent_prior_provenance_gate",
                            "target_only_residuals",
                            "independent_review",
                            "meta_audit",
                            "comparison_article_inventory",
                            "comparison_article_program_routes"
                        ],
    "required_receipt_counts":  [
                                    "target_stage_denominator",
                                    "target_atom_denominator",
                                    "micah_stage_denominator",
                                    "expected_matrix_cells",
                                    "completed_matrix_cells",
                                    "unresolved_matrix_cells",
                                    "source_families_searched",
                                    "source_families_unsearched_or_inaccessible",
                                    "alternate_era_queries_run",
                                    "favorable_document_instances_recovered",
                                    "weak_or_duplicate_instances_preserved",
                                    "author_attributed_favorable_edges",
                                    "positive_deltas_recovered",
                                    "before_state_operations_bound",
                                    "before_states_with_explicit_absent_blumberg_delta",
                                    "later_target_documents_tested_against_blumberg_delta",
                                    "bounded_negative_cells",
                                    "comparison_article_denominator",
                                    "comparison_articles_reviewed",
                                    "comparison_articles_program_linked",
                                    "comparison_articles_unresolved"
                                ],
    "closure_rule":  "An adverse disposition remains genealogy-saturation-open and challenge-open until every applicable cell has a defensible state and independent meta-audit confirms passage-level, era-translated coverage.",
    "preservation_rule":  "Every favorable Micah-atom by target-document finding remains an immutable lossless event, including weak, overlapping, duplicate, and multi-author instances. Deduplication is a separate analytical view and never deletes, hides, zeros, or overwrites an instance. A document edge fans out to every named author while authorship remains separate from evidence of individual intellectual contribution.",
    "earlier_later_asymmetry_rule":  "An earlier target operation is recorded as atom-specific before-state-boundary metadata, never as a rival award, author-wide floor, or terminal precursor page status. Every boundary must state the Micah Blumberg delta absent from that before-state. Every later target document or version is then tested losslessly against each applicable dated Blumberg delta.",
    "date_boundary":  "An early functional operation may carry its own bounded date. Mature terminology retains its actual later date. Internal, owner-metadata, public-platform, Git-fixation, archive-custody, and later-publication dates remain separate.",
    "claims_boundary":  "This gate raises the required search and closure burden. It does not manufacture a priority win, prove access or copying, or convert private discovery evidence into public custody.",
    "canonical_count_effect":  0,
    "protected_verdict_changes":  0,
    "comparison_article_rule":  "Every comparison-oriented SVGN.io, Medium/VRMA, Substack, and WordPress article is a mandatory candidate source lead. Its underlying Micah and rival sources must be verified before atom certification; no adverse result closes while a relevant article is unreviewed or unlinked."
}
